<?xml version="1.0" ?>
<!-- SINH TỰ ĐỘNG bởi scripts/rl/newarm_make_sim.py
     Giống sim tay cũ: tắt trọng lực + tự va chạm (điều khiển vị trí thuần). -->
<robot name="newarm" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="link_gazebo" params="link_name">
  <gazebo reference="${link_name}">
    <self_collide>false</self_collide>
    <gravity>false</gravity>
  </gazebo>
</xacro:macro>
<xacro:link_gazebo link_name="base_link"/>
<xacro:link_gazebo link_name="DigitalServo8120_1"/>
<xacro:link_gazebo link_name="rds3120_1"/>
<xacro:link_gazebo link_name="rds3120_support_1"/>
<xacro:link_gazebo link_name="link1_1"/>
<xacro:link_gazebo link_name="Servo_mg996_BracketM_1"/>
<xacro:link_gazebo link_name="MG996R_servo_1"/>
<xacro:link_gazebo link_name="banhrang_mg996_1"/>
<xacro:link_gazebo link_name="ServoBracketU_1"/>
<xacro:link_gazebo link_name="link2_1"/>
<xacro:link_gazebo link_name="MG996R_servo__1__1"/>
<xacro:link_gazebo link_name="banhrang_mg996__1__1"/>
<xacro:link_gazebo link_name="hopbut_1"/>
<xacro:link_gazebo link_name="but_1"/>

<gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <visualize>true</visualize>
    <update_rate>30.0</update_rate>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image><width>640</width><height>480</height><format>R8G8B8</format></image>
      <clip><near>0.02</near><far>300</far></clip>
    </camera>
    <topic>camera/image_raw</topic>
  </sensor>
</gazebo>
</robot>
