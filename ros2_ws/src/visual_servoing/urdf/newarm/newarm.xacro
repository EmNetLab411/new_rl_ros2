<?xml version="1.0" ?>
<!-- SINH TỰ ĐỘNG bởi scripts/rl/newarm_make_sim.py — đừng sửa tay. -->
<robot name="newarm" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="elbow_lower" default="-0.523599"/>
<xacro:arg name="elbow_upper" default="2.617994"/>
<xacro:include filename="$(find visual_servoing)/urdf/newarm/materials.xacro" />
<xacro:include filename="$(find visual_servoing)/urdf/newarm/newarm.ros2_control.xacro" />
<xacro:include filename="$(find visual_servoing)/urdf/newarm/newarm.gazebo.xacro" />

<!-- base_link cố định vào world: trục J1 trùng trục Z world, tay hướng về +X -->
<link name="world"/>
<joint name="world_fixed" type="fixed">
  <origin xyz="0.024973 0.01315 0.1" rpy="0 0 1.570796"/>
  <parent link="world"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="-0.013099 0.035685 0.430136" rpy="0 0 0"/>
    <mass value="0.417679"/>
    <inertia ixx="0.000178" iyy="0.000285" izz="0.000442" ixy="-0" iyz="0" ixz="-0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://visual_servoing/meshes/newarm/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="DigitalServo8120_1">
  <inertial>
    <origin xyz="-0.0039 0.023711 0.010048" rpy="0 0 0"/>
    <mass value="0.252337"/>
    <inertia ixx="6.8e-05" iyy="4.1e-05" izz="4.3e-05" ixy="0" iyz="-1e-06" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="0.009205 -0.011786 -0.433355" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://visual_servoing/meshes/newarm/DigitalServo8120_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="rds3120_1">
  <inertial>
    <origin xyz="-0.000427 0.000041 -0.022017" rpy="0 0 0"/>
    <mass value="0.0385774"/>
    <inertia ixx="7e-06" iyy="1.3e-05" izz="8e-06" ixy="-0" iyz="0" ixz="-0"/>
  </inertial>
  <visual>
    <origin xyz="0.01315 -0.024973 -0.418382" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://visual_servoing/meshes/newarm/rds3120_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="rds3120_support_1">
  <inertial>
    <origin xyz="-0.0258 0.017355 0" rpy="1.570796 0 0"/>
    <mass value="0.0114569"/>
    <inertia ixx="2e-06" iyy="7e-06" izz="6e-06" ixy="0" iyz="-0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.013095 0.385135 -0.024973" rpy="1.570796 0 0"/>
    <geometry>
      <mesh filename="package://visual_servoing/meshes/newarm/rds3120_support_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="link1_1">
  <inertial>
    <origin xyz="-0.014829 0.071625 0.026919" rpy="1.570796 0 0"/>
    <mass value="0.458776"/>
    <inertia ixx="0.000573" iyy="0.000566" izz="7.5e-05" ixy="0" iyz="0" ixz="-0"/>
  </inertial>
  <visual>
    <origin xyz="-0.002145 0.380185 0.002027" rpy="1.570796 0 0"/>
