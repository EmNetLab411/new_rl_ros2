<?xml version="1.0"?>
<!-- SINH TỰ ĐỘNG bởi scripts/rl/newarm_make_sim.py
     Bảng workspace in thật của tay mới: marker 30mm, tâm marker ±75mm,
     vùng vẽ 100x100mm (khung xám). Không có collision: bút đi xuyên qua bảng. -->
<sdf version="1.8">
  <model name="newarm_board">
    <static>true</static>
    <link name="board_link">
      <visual name="paper">
        <geometry><box><size>0.001 0.19 0.19</size></box></geometry>
        <material>
          <ambient>0.98 0.98 0.98 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="marker_0">
        <pose>-0.0012 0.075 0.075 0 0 1.5708</pose>
        <geometry><box><size>0.03 0.002 0.03</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://aruco_marker_0/materials/textures/marker_0.png</albedo_map></metal></pbr>
        </material>
      </visual>
      <visual name="marker_1">
        <pose>-0.0012 -0.075 0.075 0 0 1.5708</pose>
        <geometry><box><size>0.03 0.002 0.03</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://aruco_marker_1/materials/textures/marker_1.png</albedo_map></metal></pbr>
        </material>
      </visual>
      <visual name="marker_2">
        <pose>-0.0012 -0.075 -0.075 0 0 1.5708</pose>
        <geometry><box><size>0.03 0.002 0.03</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://aruco_marker_2/materials/textures/marker_2.png</albedo_map></metal></pbr>
        </material>
      </visual>
      <visual name="marker_3">
        <pose>-0.0012 0.075 -0.075 0 0 1.5708</pose>
        <geometry><box><size>0.03 0.002 0.03</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://aruco_marker_3/materials/textures/marker_3.png</albedo_map></metal></pbr>
        </material>
      </visual>
      <visual name="draw_zone_0">
        <pose>-0.0006 0 0.05 0 0 0</pose>
        <geometry><box><size>0.0002 0.1 0.001</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
      <visual name="draw_zone_1">
        <pose>-0.0006 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.0002 0.1 0.001</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
      <visual name="draw_zone_2">
        <pose>-0.0006 0.05 0 0 0 0</pose>
        <geometry><box><size>0.0002 0.001 0.1</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
      <visual name="draw_zone_3">
        <pose>-0.0006 -0.05 0 0 0 0</pose>
        <geometry><box><size>0.0002 0.001 0.1</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
